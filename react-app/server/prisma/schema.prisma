generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())

  email        String   @unique
  username     String   @unique
  passwordHash String

  firstName    String
  lastName     String
  birthDate    String
  course       String
  city         String   @default("Konstanz")
  pricePerKm   Float    @default(0.35)
  avatarUrl    String   @default("")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rides        Ride[]
  ownedChatContacts ChatContact[] @relation("ChatOwner")
  chatContacts ChatContact[] @relation("ChatUser")
  sentMessages ChatMessage[]
}

model Ride {
  id                 String   @id @default(cuid())
  departureName      String
  destinationName    String
  departureLat       Float
  departureLng       Float
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float
  durationMinutes    Int
  driverId           String
  departureTime      String
  seatsAvailable     Int
  price              Float
  extra              String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  driver             User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model ChatContact {
  id        String   @id @default(cuid())
  ownerId   String
  userId    String

  owner     User     @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user      User     @relation("ChatUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  contactId String
  senderId  String
  type      String
  content   String
  sentAt    String

  contact   ChatContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}